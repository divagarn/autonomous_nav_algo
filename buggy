#!/usr/bin/env bash
# buggy - one entry point for the PCD + Lanelet2 localisation / AUTO stack.
# Run `./buggy help`. Everything it needs is inside this folder.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/setup.bash"
PKG=buggy_pcd_lanelet_map
SCRIPTS="$HERE/src/$PKG/scripts"

usage() { cat <<USAGE
buggy - PCD + Lanelet2 localisation, routing and AUTO driving for the buggy

  ./buggy build [--clean]                    build all packages in this folder
  ./buggy doctor                             check software + hardware (run this first)
  ./buggy maps                               list the maps in data/maps

  ./buggy view   [MAP]                       map + RViz + simulated AUTO (no sensors, no hardware)
  ./buggy live   [MAP] [options]             REAL buggy: VLP-16 + ECU feedback + NDT localisation
  ./buggy replay BAG [MAP] [options]         same stack on a recorded rosbag (no hardware)
  ./buggy sim    [MAP] [--radar] [gui:=true] Gazebo + emulated ECU, closed loop (no hardware)

  ./buggy calibrate-brake [--preset 2|4] [--live]   measure the real stopping behaviour
  ./buggy add-map NAME FILE.osm [--pcd FILE.pcd]    create a map folder from a Vector Map Builder export
  ./buggy sim-map [--save]                   record a PCD of the Gazebo world (then --save)
  ./buggy stop                               stop a running launch cleanly (Ctrl+C also works)
  ./buggy ros2 ...                           any ros2 command inside this environment

live / replay options
  --drive        arm AUTO: steering + stop flags are published, uart_writer logs the frames
                 (LOOPBACK: nothing is written to the serial port)
  --real         with --drive: uart_writer REALLY WRITES to the ECU (the buggy moves in AUTO)
  --no-rviz      do not open RViz
  --no-detector  no LiDAR obstacle detection (AUTO then refuses to start)
  --radar        add radar obstacles (umrr radar on CAN + radar_fusion; Gazebo: synthetic radar)
  --avoid        go around an obstacle that blocks the lane for >5 s (default ON in view/sim, OFF live/replay);
                 --no-avoid turns it off
  --cpp          run the C++ runtime nodes (uart_writer, uart_bridge, wheel_odometry, lidar_preprocess, odom_to_twist, velodyne_static_tf, localization_manager, route_planner, avoidance_planner, segment_ground, self_hit_filter, lidar_obstacle_detector, operation_manager) from buggy_core
  --camera       camera + object-detection model: obstacles get a class name instead of "unknown"
                 (detector_model:=<onnx>  camera_device:=/dev/video0  can_interface:=can0
                 labeler_debug:=true publishes /perception/labeler_debug/image)
  key:=value     passed to ros2 launch (voxel_size:=0.5 ndt_rate_hz:=5.0 feedback_port:=/dev/ttyUSB1
                 sender_port:=... corridor_half_width:=1.0 bag_start_delay:=12.0 ...)
MAP is a folder name in data/maps (default new_delhi_map) or a full path.
Data folder: \$BUGGY_DATA_DIR (default: $HERE/data)
USAGE
}

need_build() {
  ros2 pkg prefix "$PKG" >/dev/null 2>&1 || { echo "Not built yet: run  ./buggy build"; exit 1; }
}
fresh_graph() { ros2 daemon stop >/dev/null 2>&1; }   # a stale daemon hides topics
clean_hw() {  # a leftover driver keeps the UDP/serial port open and silently starves the new run
  pkill -x velodyne_driver_node 2>/dev/null; pkill -x velodyne_transform_node 2>/dev/null
  pkill -f '__node:=[u]art_bridge' 2>/dev/null; true
}
# Other ROS nodes on the same ROS_DOMAIN_ID (a second ./buggy, the old stack, a bag-play container...)
# share the graph with this one: duplicate nodes and a second publisher of base_link make the pose,
# the vehicle and the RViz view jump. Refuse to start next to them.
guard_graph() {
  [ -n "${BUGGY_FORCE:-}" ] && return 0
  local nodes
  nodes=$(timeout 10 ros2 node list --spin-time 3 2>/dev/null | grep -vE '^/(rviz|transform_listener_impl|_ros2cli|launch_ros)' | sort -u)
  if [ -n "$nodes" ]; then
    echo "Other ROS nodes are already running in ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}:"
    echo "$nodes" | sed 's/^/    /' | head -12
    echo "They would share the graph with this run and can make the pose / RViz view jump."
    echo "Stop them (./buggy stop, close the other terminals), or use a private domain:"
    echo "    ROS_DOMAIN_ID=42 ./buggy $cmd ...        (BUGGY_FORCE=1 ignores this check)"
    exit 1
  fi
}
confirm_real() {
  echo "!!! REAL UART WRITE: the buggy WILL MOVE when AUTO is engaged."
  echo "    Wheels clear? Safety driver ready and able to brake? Type YES to continue:"
  read -r a; [ "$a" = YES ] || { echo aborted; exit 1; }
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;

  build)
    cd "$HERE" || exit 1
    [ "${1:-}" = "--clean" ] && rm -rf build install log
    colcon build --symlink-install --base-paths src --cmake-args -DCMAKE_BUILD_TYPE=Release \
      && echo "built. Next: ./buggy doctor" ;;

  doctor)
    ok=1
    chk() { if eval "$2" >/dev/null 2>&1; then printf '  [OK]      %s\n' "$1"; else printf '  [MISSING] %s%s\n' "$1" "${3:+  -> $3}"; ok=0; fi; }
    echo "ROS packages"
    for p in autoware_map_loader autoware_map_projection_loader autoware_ndt_scan_matcher \
             autoware_ekf_localizer autoware_perception_msgs autoware_internal_localization_msgs \
             autoware_internal_debug_msgs rviz2 tf_transformations cv_bridge sensor_msgs_py; do
      chk "$p" "ros2 pkg prefix $p" "sudo apt install ros-humble-$(echo "$p" | tr _ -)"
    done
    echo "Gazebo simulation (only for ./buggy sim / sim-map)"
    for p in gazebo_ros gazebo_ros2_control ackermann_steering_controller xacro joint_state_broadcaster; do
      chk "$p" "ros2 pkg prefix $p" "sudo apt install ros-humble-$(echo "$p" | tr _ -)"
    done
    echo "Optional: radar + camera names (--radar / --camera)"
    chk "onnxruntime (YOLOX detector)" "python3 -c 'import onnxruntime'" "pip install onnxruntime"
    chk "opencv python (cv2)" "python3 -c 'import cv2'" "sudo apt install python3-opencv"
    chk "detector model data/models/yolox_s_ti_18class_ti_today_qat.onnx" "[ -f $BUGGY_DATA_DIR/models/yolox_s_ti_18class_ti_today_qat.onnx ]" "copy the .onnx there or pass detector_model:=<path>"
    chk "radar driver + radar_fusion built" "ros2 pkg prefix radar_fusion && ros2 pkg prefix umrr_ros2_driver" "./buggy build"
    echo "Python"
    for m in serial scipy numpy yaml; do chk "python3 $m" "python3 -c 'import $m'" "pip/apt: pyserial scipy numpy pyyaml"; done
    echo "This package"
    chk "built (install/)" "ros2 pkg prefix $PKG" "./buggy build"
    chk "C++ runtime core built (buggy_core, for --cpp)" "ros2 pkg prefix buggy_core" "./buggy build"
    echo "Maps (data/maps)"
    for d in "$BUGGY_DATA_DIR"/maps/*/; do
      n=$(basename "$d"); good=1
      for f in lanelet2_map.osm pointcloud_map.pcd map_projector_info.yaml pointcloud_map_metadata.yaml; do [ -e "$d/$f" ] || good=0; done
      chk "map $n" "[ $good = 1 ]" "needs lanelet2_map.osm pointcloud_map.pcd map_projector_info.yaml pointcloud_map_metadata.yaml"
    done
    echo "Hardware (fails here if the buggy is not connected - fine for sim/replay)"
    python3 "$SCRIPTS/live_preflight.py" || ok=0
    [ $ok = 1 ] && echo "ALL OK" || echo "Some checks failed (see above)." ;;

  maps)
    for d in "$BUGGY_DATA_DIR"/maps/*/; do
      n=$(basename "$d")
      lan=$(grep -c 'k="type" v="lanelet"' "$d/lanelet2_map.osm" 2>/dev/null)
      sz=$(du -shL "$d/pointcloud_map.pcd" 2>/dev/null | cut -f1)
      printf '%-22s lanelets: %-4s pcd: %s\n' "$n" "${lan:-?}" "${sz:-MISSING}"
    done ;;

  add-map) python3 "$SCRIPTS/add_map.py" "$@" ;;

  view)
    need_build; fresh_graph; guard_graph
    MAP=""; ARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --no-rviz) ARGS+=(rviz:=false) ;;
        --avoid) ARGS+=(avoidance:=true) ;; --no-avoid) ARGS+=(avoidance:=false) ;; --cpp) ARGS+=(core:=cpp) ;;
        *:=*) ARGS+=("$1") ;;
        -*) echo "unknown option $1"; exit 1 ;;
        *) MAP="$1" ;;
      esac; shift
    done
    [ -n "$MAP" ] && ARGS+=("map_path:=$MAP")
    exec ros2 launch $PKG buggy.launch.py "${ARGS[@]}" ;;

  live|replay)
    need_build
    MAP=""; BAG=""; DRIVE=0; REAL=0; ARGS=()
    [ "$cmd" = replay ] && { BAG="${1:-}"; [ -n "$BAG" ] || { echo "usage: ./buggy replay BAG [MAP]"; exit 1; }; shift; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --drive) DRIVE=1 ;; --real) REAL=1 ;;
        --no-rviz) ARGS+=(rviz:=false) ;; --no-detector) ARGS+=(obstacle_detection:=false) ;;
        --radar) ARGS+=(radar:=true) ;; --camera) ARGS+=(camera:=true) ;;
        --avoid) ARGS+=(avoidance:=true) ;; --no-avoid) ARGS+=(avoidance:=false) ;; --cpp) ARGS+=(core:=cpp) ;;
        *:=*) ARGS+=("$1") ;;
        -*) echo "unknown option $1"; exit 1 ;;
        *) MAP="$1" ;;
      esac; shift
    done
    [ -n "$MAP" ] && ARGS+=("map_path:=$MAP")
    [ -n "$BAG" ] && ARGS+=("bag_path:=$BAG")
    if [ $REAL = 1 ]; then
      [ $DRIVE = 1 ] || { echo "--real needs --drive"; exit 1; }
      [ -z "$BAG" ] || { echo "refusing real UART write while replaying a bag"; exit 1; }
      confirm_real
      ARGS+=(loopback:=false)
    fi
    [ $DRIVE = 1 ] && ARGS+=(drive:=true uart_write:=true)
    fresh_graph; guard_graph
    if [ -z "$BAG" ]; then
      clean_hw
      python3 "$SCRIPTS/live_preflight.py" || { echo "Preflight reported problems. Continue anyway? [y/N]"; read -r a; [ "$a" = y ] || exit 1; }
    fi
    exec ros2 launch $PKG live.launch.py "${ARGS[@]}" ;;

  sim)
    need_build; fresh_graph; guard_graph
    MAP=""; ARGS=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --radar) ARGS+=(radar:=true) ;; --camera) ARGS+=(camera:=true) ;; --no-rviz) ARGS+=(rviz:=false) ;;
        --avoid) ARGS+=(avoidance:=true) ;; --no-avoid) ARGS+=(avoidance:=false) ;; --cpp) ARGS+=(core:=cpp) ;;
        *:=*) ARGS+=("$1") ;;
        -*) echo "unknown option $1"; exit 1 ;;
        *) MAP="$1" ;;
      esac; shift
    done
    [ -n "$MAP" ] && ARGS+=("map_path:=$MAP")
    exec ros2 launch $PKG sim_live.launch.py "${ARGS[@]}" ;;

  sim-map)
    need_build
    if [ "${1:-}" = "--save" ]; then
      exec ros2 service call /save_pointcloud_map std_srvs/srv/Trigger "{}"
    fi
    fresh_graph; guard_graph
    exec ros2 launch $PKG sim_build_map.launch.py "$@" ;;

  calibrate-brake)
    need_build; fresh_graph; guard_graph
    LIVE=0; PASS=(); LB=true; EXTRA=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --live) LIVE=1; LB=false; PASS+=(--live) ;;
        --cpp) EXTRA+=(core:=cpp) ;;
        *:=*) EXTRA+=("$1") ;;
        *) PASS+=("$1") ;;
      esac; shift
    done
    if [ $LIVE = 1 ]; then
      echo "!!! LIVE BRAKE TEST: the buggy will drive STRAIGHT at the preset speed, then stop."
      echo "    Needs >= 15 m of clear flat space, nobody near, safety driver ready."
      confirm_real
    fi
    clean_hw
    LOG="$BUGGY_DATA_DIR/calibration_base.log"; mkdir -p "$BUGGY_DATA_DIR"
    # job control: without it a script's background job ignores SIGINT and could never be stopped
    set -m
    ros2 launch $PKG calibration_base.launch.py loopback:=$LB "${EXTRA[@]}" >"$LOG" 2>&1 &
    BASE=$!
    stop_base() { kill -INT "$BASE" 2>/dev/null; wait "$BASE" 2>/dev/null; }   # uart_writer sends a final STOP
    trap stop_base EXIT
    echo "starting ECU feedback + UART writer ($( [ $LIVE = 1 ] && echo REAL || echo loopback )); log: $LOG"
    sleep 6
    ros2 run $PKG brake_calibration "${PASS[@]}" ;;

  stop)
    # only launches of THIS ROS domain: another terminal's run (other ROS_DOMAIN_ID) is left alone
    n=0; pids=""
    for pid in $(pgrep -f 'bin/ros2 launch buggy_pcd_lanelet_map'); do
      dom=$(tr '\0' '\n' < /proc/$pid/environ 2>/dev/null | sed -n 's/^ROS_DOMAIN_ID=//p')
      if [ "${dom:-0}" = "${ROS_DOMAIN_ID:-0}" ]; then kill -INT "$pid" && n=$((n+1)) && pids="$pids $pid"; fi
    done
    # a launch started in the background by a script ignores Ctrl+C: fall back to SIGTERM after 6 s
    sleep 6
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null; done
    [ $n -gt 0 ] && echo "sent Ctrl+C to $n launch(es) in ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}" || echo "no launch running in ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}" ;;

  ros2) exec ros2 "$@" ;;

  *) echo "unknown command: $cmd"; usage; exit 1 ;;
esac
