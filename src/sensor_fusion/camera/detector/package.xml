<?xml version="1.0"?>
<package format="3">
  <name>object_detection</name>
  <version>0.1.0</version>
  <description>Camera object detection (JSON replay on PC, YOLO TensorRT on Orin, ONNX Runtime / OpenCV DNN optional) + ByteTrack-style 2D tracking.</description>
  <maintainer email="gowtham2351995@gmail.com">gowtham</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>fusion_common</depend>
  <depend>rosbag2_cpp</depend>
  <depend>nav_msgs</depend>
  <depend>lane_estimation</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
