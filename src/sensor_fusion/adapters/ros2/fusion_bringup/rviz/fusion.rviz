Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Recorded Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: /map_updates
      Use Timestamp: false
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 20
      Offset: {X: 40, Y: 0, Z: -0.5}
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1
      Name: Base Link Origin
      Radius: 0.06
      Reference Frame: base_link
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1
      Name: Radar Origin (UMRR)
      Radius: 0.06
      Reference Frame: umrr
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Bag LiDAR
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /velodyne_points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 0; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Radar targets (raw)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.25
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /smart_radar/can_targets_0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: All objects
      Enabled: true
      Topic:
        Value: /fusion_visualization/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Moving / in path
      Enabled: false
      Topic:
        Value: /fusion_visualization/markers_relevant
    - Class: rviz_default_plugins/MarkerArray
      Name: Lane (base_link)
      Enabled: false
      Topic:
        Value: /fusion_visualization/lane_markers_base
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /object_detection/image_rect
        Reliability Policy: Best Effort
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.75
      Yaw: 3.14
      Target Frame: base_link
Window Geometry:
  Width: 1600
  Height: 1000
