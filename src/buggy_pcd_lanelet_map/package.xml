<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buggy_pcd_lanelet_map</name>
  <version>0.1.0</version>
  <description>
    Autoware-style map bring-up: a PCD point cloud map plus a Lanelet2 map,
    loaded from one map folder (pointcloud_map.pcd, lanelet2_map.osm,
    map_projector_info.yaml) with autoware_map_loader, and a lanelet marker
    publisher for RViz.
  </description>
  <maintainer email="n.divagar18@gmail.com">divagar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>autoware_map_projection_loader</exec_depend>
  <exec_depend>autoware_perception_msgs</exec_depend>
  <exec_depend>autoware_ndt_scan_matcher</exec_depend>
  <exec_depend>autoware_ekf_localizer</exec_depend>
  <exec_depend>autoware_internal_localization_msgs</exec_depend>
  <exec_depend>autoware_internal_debug_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>ground_segmentation_msgs</exec_depend>
  <exec_depend>buggy_perception</exec_depend>
  <exec_depend>buggy_uart</exec_depend>
  <exec_depend>buggy_description</exec_depend>
  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>buggy_core</exec_depend>
  <exec_depend>perception_msgs</exec_depend>
  <exec_depend>umrr_ros2_msgs</exec_depend>
  <!-- radar / camera (radar:=true, camera:=true): our sensor fusion (src/sensor_fusion) -->
  <exec_depend>fusion_bringup</exec_depend>
  <!-- umrr_ros2_driver (radar:=true on the buggy) is not a dependency: it is built on the Orin only -->
  <exec_depend>camera_processing</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>buggy_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
