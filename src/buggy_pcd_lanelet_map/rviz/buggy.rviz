Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Vehicle1
        - /Planning1
  - Class: buggy_rviz_plugins/BuggyStatePanel
    Name: Buggy State
  # camera views (hidden until a button is pressed): Camera feed / Camera overlay feed / Lane path curvature
  - Class: buggy_rviz_plugins/CameraViewPanel
    Name: Camera Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 12; 22; 60
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_common/Group
      Name: Map
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: PointCloud Map
          Enabled: true
          Topic:
            Value: /map/pointcloud_map_display
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Style: Points
          Size (Pixels): 2
          Color Transformer: AxisColor
          Axis: Z
          Use rainbow: true
        - Class: rviz_default_plugins/MarkerArray
          Name: Lanelet2 Map
          Enabled: true
          Topic:
            Value: /map/vector_map_marker
            Durability Policy: Transient Local
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/Grid
          Name: Grid
          Enabled: false
    - Class: rviz_common/Group
      Name: Vehicle
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Name: Vehicle Model
          Enabled: true
          Topic:
            Value: /vehicle/marker
        - Class: rviz_default_plugins/TF
          Name: TF
          Enabled: true
          Marker Scale: 2
          Show Names: false
    - Class: rviz_common/Group
      Name: Planning
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Name: Route
          Enabled: true
          Topic:
            Value: /planning/route_marker
            Durability Policy: Transient Local
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/MarkerArray
          Name: Mission stops
          Enabled: true
          Topic:
            Value: /mission/markers
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/Path
          Name: Route Path
          Enabled: false
          Topic:
            Value: /planning/route_path
            Durability Policy: Transient Local
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/MarkerArray
          Name: Detour (cyan = in lane, magenta = outside lane)
          Enabled: true
          Topic:
            Value: /planning/detour_marker
        - Class: rviz_default_plugins/MarkerArray
          Name: Free space outside the lane (green)
          Enabled: true
          Topic:
            Value: /planning/free_space_marker
        - Class: rviz_default_plugins/MarkerArray
          Name: HOME
          Enabled: true
          Topic:
            Value: /planning/home_marker
            Durability Policy: Transient Local
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/MarkerArray
          Name: Stop / Slow Zones
          Enabled: true
          Topic:
            Value: /planning/stop_zone_marker
    - Class: rviz_common/Group
      Name: Perception
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: Live Scan (matched)
          Enabled: true
          Topic:
            Value: /localization/pointcloud_downsampled
          Style: Flat Squares
          Size (m): 0.12
          Color Transformer: FlatColor
          Color: 255; 40; 40
          Alpha: 1
        - Class: rviz_default_plugins/MarkerArray
          Name: Dummy Objects
          Enabled: true
          Topic:
            Value: /simulation/dummy_objects/marker
        - Class: rviz_default_plugins/MarkerArray
          Name: LiDAR Objects
          Enabled: true
          Topic:
            Value: /perception/lidar_objects_marker
        # sensor_fusion objects as the AUTO logic sees them (radar_object_bridge: orange boxes)
        - Class: rviz_default_plugins/MarkerArray
          Name: Radar Objects (sensor_fusion -> AUTO)
          Enabled: true
          Topic:
            Value: /perception/radar_objects_marker
        - Class: rviz_default_plugins/MarkerArray
          Name: Labeled Objects (camera names)
          Enabled: true
          Topic:
            Value: /perception/objects_marker
    # sensor_fusion (--radar / --camera), one display per topic
    - Class: rviz_common/Group
      Name: Sensor Fusion
      Enabled: true
      Displays:
        # fused tracks + ego path + stop zone + camera lane markings / road edges / tracked path, in map
        # (needs map -> base_link: localised)
        - Class: rviz_default_plugins/MarkerArray
          Name: Fused Objects + Lane (map)
          Enabled: true
          Topic:
            Value: /fusion_visualization/markers
        - Class: rviz_default_plugins/MarkerArray
          Name: Fused Objects, moving / in path only
          Enabled: false
          Topic:
            Value: /fusion_visualization/markers_relevant
        # the same lane / road edges / path in base_link: shown also when NDT is not localised
        - Class: rviz_default_plugins/MarkerArray
          Name: Lane + Road Edges (base_link)
          Enabled: false
          Topic:
            Value: /fusion_visualization/lane_markers_base
        - Class: rviz_default_plugins/Path
          Name: Lane Path (camera, 20 m)
          Enabled: true
          Topic:
            Value: /sensor_fusion/lane_path
          Color: 0; 220; 120
          Line Style: Billboards
          Line Width: 0.08
        # camera image with fused boxes, lane mask and path drawn on it: only with --overlay
        - Class: rviz_default_plugins/Image
          Name: Camera Overlay (--overlay)
          Enabled: false              # the Camera Views panel shows it on a button
          Topic:
            Value: /fusion_visualization/overlay
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Normalize Range: true
        # plain rectified camera image of the detector (no drawing; works without --overlay)
        - Class: rviz_default_plugins/Image
          Name: Camera (rectified)
          Enabled: false
          Topic:
            Value: /object_detection/image_rect
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
          Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: buggy_rviz_plugins/AddCarTool
    - Class: buggy_rviz_plugins/AddBusTool
    - Class: buggy_rviz_plugins/AddPedestrianTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 8
      Target Frame: map
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top Down
        Scale: 8
        Target Frame: map
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 60
        Pitch: 0.8
        Target Frame: map
      - Class: rviz_default_plugins/ThirdPersonFollower
        Name: Follow Vehicle
        Distance: 25
        Pitch: 0.7
        Target Frame: base_link
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
